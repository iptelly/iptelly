# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# Compiled output
/target/
/.flatpak-builder/

# Local machine-specific cargo flags (e.g. AVX2) - never committed, since
# CI and other contributors' machines may not support them.
/.cargo/config.toml
/tmp

# Leftovers from the removed TV app
/apps/
/packages/
/node_modules/
/.yarn/

# Placeholder files that sandboxed tools leave in the checkout
/.bash_profile
/.bashrc
/.gitconfig
/.profile
/.ripgreprc
/.zprofile
/.zshrc
/build.xml
/scripts
/.mcp.json

# IDEs and editors
.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Visual Studio Code
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*

# System files
.DS_Store
Thumbs.db
