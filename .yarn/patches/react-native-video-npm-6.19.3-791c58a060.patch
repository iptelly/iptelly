+        synchronized (frameTimes) {
+            frameTimes.add(presentationTimeUs);
+            if (frameTimes.size() < FRAMES_TO_MEASURE) {
+                return;
+            }
+            // The median gap between frames, which skips over dropped frames
+            // and jumps in the timestamps.
+            long[] gaps = new long[frameTimes.size() - 1];
+            for (int i = 1; i < frameTimes.size(); i++) {
+                gaps[i - 1] = frameTimes.get(i) - frameTimes.get(i - 1);
+            }
+            frameTimes.clear();
+            Arrays.sort(gaps);
+            long gap = gaps[gaps.length / 2];
+            if (gap <= 0) {
+                return;
+            }
+            rate = 1_000_000f / gap;
