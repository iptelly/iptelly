{
  // Needs the CodeLLDB extension.
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug IPTelly",
      "cargo": {
        "args": ["build", "--package=iptelly", "--bin=iptelly"]
      }
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug IPTelly (release)",
      "cargo": {
        "args": ["build", "--release", "--package=iptelly", "--bin=iptelly"]
      }
    }
  ]
}
