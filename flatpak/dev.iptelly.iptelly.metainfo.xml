  <name>IPTelly</name>
  <summary>Fast and powerful IPTV player</summary>
  <developer id="dev.iptelly">
    <name>IPTelly</name>
  </developer>
  <content_rating type="oars-1.1" />
  <branding>
    <color type="primary" scheme_preference="light">#4549cc</color>
    <color type="primary" scheme_preference="dark">#4549cc</color>
  </branding>
  <description>
    <p>
      IPTelly is a fast and powerful IPTV player for desktop, carefully crafted to deliver the
      best IPTV experience. Watch live TV, movies and series from your IPTV provider, with
      instant search and a UI you can drive from a keyboard or TV remote.
    </p>
    <p>Features:</p>
    <ul>
      <li>Import your IPTV channels from any source (M3U file, M3U link, Xtream)</li>
      <li>Record while watching</li>
      <li>Multiple IPTV sources</li>
      <li>Control the UI from a TV remote</li>
      <li>Super low RAM usage, crazy speeds and instant search</li>
      <li>Refresh your sources when you need to</li>
      <li>Add channels to favorites</li>
      <li>Make your own custom channels and share them with friends</li>
      <li>Re-stream channels to other devices such as phones and TVs</li>
    </ul>
  </description>
  <categories>
    <category>AudioVideo</category>
    <category>Video</category>
    <category>Player</category>
    <category>TV</category>
  </categories>
