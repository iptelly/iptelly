{
  "name": "react-native-iptelly",
  "version": "0.1.0",
  "description": "IPTelly's Rust core for React Native",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "react-native-iptelly-source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "ubrn:android": "RUSTFLAGS= ubrn build android --config ubrn.config.yaml --and-generate --release && bob build",
    "ubrn:ios": "RUSTFLAGS= ubrn build ios --config ubrn.config.yaml --and-generate --release && bob build",
    "ubrn:clean": "rm -rfv cpp/ android/CMakeLists.txt android/src/main/java ios/ src/Native* src/index.*ts* src/generated/",
    "clean": "del-cli android/build lib",
    "prepare": "bob build",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\""
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iptelly/iptelly.git"
  },
  "author": "jeffsmith82 <jeffsmith82@users.noreply.github.com> (https://github.com/jeffsmith82)",
  "license": "GPL-2.0-only",
  "bugs": {
    "url": "https://github.com/iptelly/iptelly/issues"
  },
  "homepage": "https://github.com/iptelly/iptelly#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@react-native-community/cli": "20.0.0",
    "@react-native/babel-preset": "0.83.0",
    "@react-native/eslint-config": "0.86.2",
    "@types/react": "^19.2.0",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "react": "19.2.0",
    "react-native": "npm:react-native-tvos@0.83.0-0",
    "react-native-builder-bob": "^0.43.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@ubjs/core": "0.31.0-6",
    "uniffi-bindgen-react-native": "0.31.0-6"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ],
      "codegen"
    ]
  },
  "codegenConfig": {
    "name": "IptellySpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "outputDir": {
      "ios": "ios/generated",
      "android": "android/generated"
    },
    "android": {
      "javaPackageName": "com.iptelly"
    },
    "includesGeneratedCode": true
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "create-react-native-library": {
    "type": "turbo-module",
    "languages": "cpp",
    "tools": [
      "eslint"
    ],
    "version": "0.63.1"
  }
}
