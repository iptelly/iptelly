import { Button, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { HomeState } from "state.slint";

struct Shortcut {
    keys: string,
    description: string,
}

component Section inherits VerticalLayout {
    in property <string> title;
    in property <[Shortcut]> shortcuts;

    spacing: 6px;
    Text {
        text: title;
        font-size: 15px;
        font-weight: 600;
        color: Theme.text-primary;
    }
    for shortcut in shortcuts: HorizontalLayout {
        spacing: 12px;
        Text {
            text: shortcut.description;
            horizontal-stretch: 1;
            color: Theme.text-secondary;
        }
        Rectangle {
            border-radius: 4px;
            background: Theme.surface-3;
            width: keys.preferred-width + 12px;
            keys := Text {
                text: shortcut.keys;
                font-size: 12px;
                color: Theme.text-primary;
            }
        }
    }
}

// The keyboard shortcuts help, opened with F1 (shortcuts-help-modal).
export component ShortcutsHelp inherits Rectangle {
    background: #000000a0;

    // Swallows clicks so nothing behind the help reacts.
    TouchArea { }

    FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape || event.text == Key.F1 {
                HomeState.show-help = false;
                return accept;
            }
            reject
        }

        Rectangle {
            width: min(520px, root.width - 48px);
            height: min(content.preferred-height, root.height - 48px);
            border-radius: Theme.radius-md;
            background: Theme.surface-1;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000080;
            clip: true;

            content := VerticalLayout {
                padding: 20px;
                spacing: 16px;

                Text {
                    text: "Keyboard shortcuts";
                    font-size: 18px;
                    font-weight: 600;
                    color: Theme.text-primary;
                }
                Section {
                    title: "Navigation";
                    shortcuts: [
                        { keys: "Arrow keys", description: "Move between channels" },
                        { keys: "Home / End", description: "First or last channel" },
                        { keys: "Enter", description: "Play the channel, or open it" },
                        { keys: "Menu or Shift + F10", description: "The channel's menu" },
                        { keys: "Esc", description: "Clear the search, or go back" },
                        { keys: "Tab", description: "Move between the search box, buttons and channels" },
                        { keys: "Ctrl + F", description: "Go to search (again: back to the channels)" },
                    ];
                }
                Section {
                    title: "Views";
                    shortcuts: [
                        { keys: "Ctrl + A", description: "Channels" },
                        { keys: "Ctrl + R", description: "Favourites" },
                        { keys: "Ctrl + D", description: "History" },
                    ];
                }
                Section {
                    title: "Media types";
                    shortcuts: [
                        { keys: "Ctrl + Q", description: "Show or hide livestreams" },
                        { keys: "Ctrl + W", description: "Show or hide movies" },
                        { keys: "Ctrl + E", description: "Show or hide series" },
                    ];
                }
                Section {
                    title: "Help";
                    shortcuts: [{ keys: "F1", description: "This list" }];
                }
                HorizontalLayout {
                    alignment: end;
                    Button {
                        text: "Close";
                        clicked => { HomeState.show-help = false; }
                    }
                }
            }
        }
    }
}
