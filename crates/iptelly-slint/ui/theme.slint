// Colours from src/styles.css's "modern" and "classic" themes.
export global Theme {
    in-out property <bool> classic: false;

    out property <color> bg-base: classic ? #202124 : #16171a;
    out property <color> surface-1: classic ? #1a1b1e : #1d1f23;
    out property <color> surface-2: classic ? #343a40 : #25272c;
    out property <color> surface-3: classic ? #3c4450 : #2e3036;
    out property <color> border-subtle: classic ? #ffffff0d : #ffffff12;
    out property <color> text-primary: classic ? #ffffff : #f2f2f4;
    out property <color> text-secondary: classic ? #adb5bd : #9a9ca4;
    out property <color> accent: classic ? #0d6efd : #6d6af0;
    out property <color> accent-hover: classic ? #0b5ed7 : #8481f5;
    out property <color> accent-contrast: #ffffff;
    out property <color> favorite: #f5c518;
    out property <color> danger: #dc3545;
    out property <length> radius-sm: classic ? 4px : 8px;
    out property <length> radius-md: classic ? 4px : 12px;
}

